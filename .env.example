# AI 服务配置
# 可选 provider: zhipu | deepseek | doubao
# 不填或没有对应 API Key 时自动进入 Demo 模式
AI_PROVIDER=deepseek

# DeepSeek API Key（从 https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions

# 豆包 / 火山方舟 API Key（从 https://console.volcengine.com/ark/ 获取）
# 豆包模型需要填写接入点 ID，例如：ep-2025xxxxx-xxxx
DOUBAO_API_KEY=
DOUBAO_MODEL=
# DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 智谱 AI API Key（从 https://open.bigmodel.cn/ 获取）
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-5.2
# ZHIPUAI_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# B站用户UID（从个人空间页面获取）
# 不填则使用配置文件中预设的降级视频列表
BILIBILI_MID=

# Giscus 评论系统配置（用于社区讨论，实现所有人可见的留言）
# 访问 https://giscus.app 输入你的 GitHub 公开仓库获取以下值
VITE_GISCUS_REPO=
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=
